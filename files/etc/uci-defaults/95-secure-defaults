#!/bin/sh
# 安全默认值（首启执行一次，执行后本脚本自动删除）

# ---- 1. 关闭 ttyd ----
# 上游 ttyd 默认配置没有 credential，网页终端直连 /bin/login；
# 配合空密码 root 等于局域网无认证 root shell。默认关闭，需要时再启用：
#   uci set ttyd.@ttyd[0].credential='user:pass'
#   uci set ttyd.@ttyd[0].enable='1'
#   uci commit ttyd && /etc/init.d/ttyd enable && /etc/init.d/ttyd start
if [ -f /etc/config/ttyd ]; then
	uci -q set ttyd.@ttyd[0].enable='0'
	uci -q commit ttyd
fi
/etc/init.d/ttyd stop 2>/dev/null
/etc/init.d/ttyd disable 2>/dev/null

# ---- 2. 只信任官方包签名 ----
# /etc/apk/keys/public-key.pem 是构建机（GitHub Runner）生成的本地签名公钥，
# 由 base-files install-key 写入。官方镜像不含此文件，删除后仍可用 openwrt-25.12.pem
# 校验 downloads.openwrt.org 的包。
[ -f /etc/apk/keys/public-key.pem ] && rm -f /etc/apk/keys/public-key.pem

# ---- 3. 默认 root 口令：首启随机生成 ----
# 空密码时生成 16 位随机口令（大小写字母 + 数字），写入 /root/.root-initial-password
# （权限 600）并记入系统日志。首次登录后请立刻修改并删除该文件：
#   passwd && rm -f /root/.root-initial-password
#
# 为什么不用固定口令：固定口令必须硬编码在本文件里，而本文件随源码公开，
# 等于向所有人公布一个可用凭据。随机生成后，固件镜像与源码仓库中都不存在可用口令。
if grep -q '^root::' /etc/shadow 2>/dev/null; then
	_INIT_PW=''
	_i=0
	while [ $_i -lt 5 ]; do
		_i=$((_i + 1))
		_C=$(head -c 128 /dev/urandom 2>/dev/null | tr -dc 'A-Za-z0-9' | cut -c1-16)
		if [ ${#_C} -eq 16 ]; then
			_INIT_PW=$_C
			break
		fi
	done

	if [ -n "$_INIT_PW" ]; then
		_SET=0
		# 首选 busybox passwd（支持从 stdin 读取，OpenWrt 上通用）
		if printf '%s\n%s\n' "$_INIT_PW" "$_INIT_PW" | passwd root >/dev/null 2>&1 \
		   && ! grep -q '^root::' /etc/shadow 2>/dev/null; then
			_SET=1
		fi
		# 兜底：openssl 生成 SHA-512 crypt
		if [ $_SET -eq 0 ] && command -v openssl >/dev/null 2>&1; then
			_H=$(openssl passwd -6 "$_INIT_PW" 2>/dev/null)
			if [ -n "$_H" ]; then
				sed -i "s|^root::|root:$_H:|" /etc/shadow && _SET=1
			fi
		fi

		if [ $_SET -eq 1 ]; then
			printf '%s\n' "$_INIT_PW" > /root/.root-initial-password
			chmod 600 /root/.root-initial-password
			logger -t secure-defaults "root 初始口令已随机生成：/root/.root-initial-password（登录后请立即 passwd 修改并删除该文件）"
		else
			logger -t secure-defaults "警告：未能设置 root 初始口令，root 仍为空密码，请立即手工设置"
		fi
	fi
	unset _INIT_PW _C _H _SET _i
fi

exit 0
