#!/bin/sh
# Preset as side-router: 192.168.5.1, upstream gateway 192.168.1.1, DHCP off.
# Switch to main-router mode with the commands in README.md.
uci -q set system.@system[0].hostname='TR3000'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

uci -q set network.lan.ipaddr='192.168.5.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q set network.lan.gateway='192.168.1.1'
uci -q set network.lan.dns='192.168.1.1'
uci -q commit network

uci -q set dhcp.lan.ignore='1'
uci -q commit dhcp

exit 0
